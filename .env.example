# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE APPS SCRIPT INTEGRATION SECRETS (Required for Google Sheets database sync)
# APPS_SCRIPT_URL: The Web App deployment URL ending in /exec
APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycbx.../exec"

# APPS_SCRIPT_TOKEN: Secret authentication token for Apps Script requests
APPS_SCRIPT_TOKEN="your_strong_secret_token_here"

# SHORTCUT_API_TOKEN: Secret Bearer token required for iPhone Shortcuts automation endpoint (/api/shortcut-import)
SHORTCUT_API_TOKEN="your_shortcut_bearer_token_here"

